#!/usr/bin/env bash
# Usage: gaming-session-switch <session_name>
#   session_name: "mango" or "gamescope" (short name, .desktop appended)
set -euo pipefail

SDDM_CONF_DIR="/etc/sddm.conf.d"
SDDM_CONF="$SDDM_CONF_DIR/theme.conf"

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <session>"
    echo "  session: 'mango' or 'gamescope'"
    exit 1
fi

case "$1" in
    mango)
        SESSION="mango.desktop"
        ;;
    gamescope)
        SESSION="gamescope-session-steam-nm.desktop"
        ;;
    *)
        echo "Unknown session: $1"
        exit 1
        ;;
esac

sudo mkdir -p "$SDDM_CONF_DIR"

if [[ -f "$SDDM_CONF" ]] && grep -q "^Current=" "$SDDM_CONF"; then
    sudo sed -i "s|^Current=.*|Current=$SESSION|" "$SDDM_CONF"
else
    echo "[Theme]
Current=$SESSION" | sudo tee "$SDDM_CONF" >/dev/null
fi

# Also update autologin session
AUTOLOGIN_CONF="$SDDM_CONF_DIR/autologin.conf"
if [[ -f "$AUTOLOGIN_CONF" ]] && grep -q "^Session=" "$AUTOLOGIN_CONF"; then
    sudo sed -i "s|^Session=.*|Session=$SESSION|" "$AUTOLOGIN_CONF"
fi

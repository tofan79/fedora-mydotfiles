#!/usr/bin/env python3
"""gaming-keybind-monitor — Listen for Super+Shift+R to exit Gaming Mode.

Uses python-evdev to read the keyboard directly (inside Gamescope where
Wayland keybinds don't work). When Super+Shift+R is detected, triggers
switch-to-desktop to return to MangoWM.
"""

import os
import subprocess
import sys
import time

import evdev
from evdev import ecodes, InputDevice, categorize, KeyEvent

# Super (KEY_LEFTMETA) + Shift (KEY_LEFTSHIFT) + R (KEY_R)
COMBO_KEYS = {ecodes.KEY_LEFTMETA, ecodes.KEY_LEFTSHIFT, ecodes.KEY_R}

def find_keyboard():
    """Find the first physical keyboard device."""
    devices = [InputDevice(path) for path in evdev.list_devices()]
    for dev in devices:
        # Skip virtual devices, mice, touchscreens
        if 'keyboard' in dev.name.lower() or 'keyboard' in dev.phys.lower():
            return dev
    # Fallback: try to find a device that has KEY_LEFTSHIFT
    for dev in devices:
        try:
            caps = dev.capabilities()
            if ecodes.EV_KEY in caps and ecodes.KEY_LEFTSHIFT in caps[ecodes.EV_KEY]:
                return dev
        except Exception:
            continue
    return None


def main():
    keyboard = find_keyboard()
    if keyboard is None:
        sys.stderr.write("gaming-keybind-monitor: no keyboard found\n")
        sys.exit(1)

    sys.stderr.write(f"gaming-keybind-monitor: watching {keyboard.name} "
                     f"({keyboard.path}) for Super+Shift+R (exit gaming mode)\n")

    pressed = set()
    last_trigger = 0.0
    debounce_ms = 500  # Prevent double-trigger

    for event in keyboard.read_loop():
        if event.type != ecodes.EV_KEY:
            continue

        key_event = categorize(event)
        code = key_event.scancode
        direction = key_event.keystate

        if direction == KeyEvent.key_down:
            pressed.add(code)
        elif direction == KeyEvent.key_up:
            pressed.discard(code)

        # Check combo: R + (LEFTMETA or RIGHTMETA) + (LEFTSHIFT or RIGHTSHIFT)
        has_meta = (ecodes.KEY_LEFTMETA in pressed or
                    ecodes.KEY_RIGHTMETA in pressed)
        has_shift = (ecodes.KEY_LEFTSHIFT in pressed or
                     ecodes.KEY_RIGHTSHIFT in pressed)
        has_r = ecodes.KEY_R in pressed

        if has_meta and has_shift and has_r:
            now = time.time() * 1000
            if now - last_trigger > debounce_ms:
                last_trigger = now
                sys.stderr.write("gaming-keybind-monitor: Super+Shift+R detected, "
                                 "switching to desktop...\n")
                subprocess.run(['/usr/local/bin/switch-to-desktop'],
                               check=False)


if __name__ == '__main__':
    main()
